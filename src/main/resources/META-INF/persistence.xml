<?xml version="1.0" encoding="UTF-8"?>

<!-- O arqvuio abaixo é responsável pela ORM com o banco de dados MySql
 driver, url, user e password tem valores default que são substituidos pelos
 valores de .env através do AppConfig-->

<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="credit_card_module" transaction-type="RESOURCE_LOCAL">
        <!-- provider -->
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Entities -->
        <class>org.jala.university.domain.entity.CreditCard</class>
        <class>org.jala.university.domain.entity.Invoice</class>
        <class>org.jala.university.domain.entity.User</class>

        <properties>
            <!-- Conexão com o MySQL -->

            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/default?useSSL=false&amp;serverTimezone=UTC"/>
            <property name="jakarta.persistence.jdbc.user" value="admin"/>
            <property name="jakarta.persistence.jdbc.password" value="admin"/>

            <!-- Dialeto do Hibernate -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQL8Dialect"/>

            <!-- Geração automática do esquema -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>

            <!-- Mostrar SQL no console -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>