<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.jala.university.presentation.controller.CardPasswordUpdateController"
            stylesheets="@styles/application.css"
            style="-fx-background-color: #F5F5F5;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="15"
              style="-fx-background-color: white; -fx-padding: 18 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 6, 0, 0, 2);">

            <HBox alignment="CENTER_LEFT" spacing="12">
                <StackPane>
                    <Circle radius="20" style="-fx-fill: #1565C0;"/>
                    <ImageView fitWidth="28" fitHeight="28" preserveRatio="true">
                        <image>
                            <Image url="@assets/jala-uni.png"/>
                        </image>
                    </ImageView>
                </StackPane>
                <Label text="JALA Bank" styleClass="text-title"
                       style="-fx-font-size: 18px; -fx-font-weight: 700;"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="Alterar Senha do Cartão"
                   style="-fx-font-size: 16px; -fx-text-fill: #424242; -fx-font-weight: 600;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Voltar" styleClass="button-secondary" onAction="#handleBack"
                    style="-fx-pref-width: 120; -fx-pref-height: 42;"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane" style="-fx-background-color: #F5F5F5;">
            <HBox alignment="CENTER" style="-fx-padding: 40;">
                <VBox spacing="30" style="-fx-max-width: 700; -fx-min-width: 700;">

                    <VBox spacing="20" styleClass="card" style="-fx-padding: 40; -fx-alignment: CENTER;">
                        <StackPane>
                            <Circle radius="50" style="-fx-fill: #EDE7F6;"/>
                            <FontAwesomeIconView glyphName="KEY" size="48" fill="#7B1FA2"/>
                        </StackPane>

                        <Label text="Alterar Senha do Cartão"
                               style="-fx-font-size: 26px; -fx-text-fill: #7B1FA2; -fx-font-weight: 700;"/>

                        <Label text="Altere a senha de 4 dígitos do seu cartão para maior segurança"
                               style="-fx-font-size: 14px; -fx-text-fill: #757575; -fx-text-alignment: center;"
                               wrapText="true" maxWidth="550"/>
                    </VBox>

                    <VBox spacing="20" styleClass="card" style="-fx-padding: 35;">
                        <Label text="Informações do Cartão"
                               style="-fx-font-size: 16px; -fx-text-fill: #424242; -fx-font-weight: 600;"/>

                        <Separator style="-fx-background-color: #E0E0E0;"/>

                        <VBox spacing="12" style="-fx-padding: 10 0;">
                            <HBox alignment="CENTER_LEFT" spacing="15">
                                <Label text="Número do Cartão:"
                                       style="-fx-font-size: 14px; -fx-text-fill: #757575; -fx-min-width: 150;"/>
                                <Label fx:id="cardNumberLabel" text="•••• •••• •••• 1234"
                                       style="-fx-font-size: 16px; -fx-text-fill: #212121; -fx-font-weight: 600; -fx-letter-spacing: 2;"/>
                            </HBox>

                            <HBox alignment="CENTER_LEFT" spacing="15">
                                <Label text="Status Atual:"
                                       style="-fx-font-size: 14px; -fx-text-fill: #757575; -fx-min-width: 150;"/>
                                <HBox fx:id="currentStatusBadgeContainer" alignment="CENTER_LEFT"/>
                            </HBox>
                        </VBox>
                    </VBox>

                    <VBox spacing="15" styleClass="card"
                          style="-fx-padding: 25; -fx-background-color: #FFF8E1; -fx-border-color: #FFA000; -fx-border-width: 2; -fx-border-radius: 12; -fx-background-radius: 12;">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <FontAwesomeIconView glyphName="INFO_CIRCLE" size="24" fill="#FFA000"/>
                            <Label text="Importante"
                                   style="-fx-font-size: 16px; -fx-text-fill: #FFA000; -fx-font-weight: 700;"/>
                        </HBox>

                        <Label text="A nova senha deve conter exatamente 4 dígitos numéricos. A alteração será efetivada imediatamente."
                               style="-fx-font-size: 14px; -fx-text-fill: #424242;"
                               wrapText="true"/>
                    </VBox>

                    <VBox spacing="25" styleClass="card" style="-fx-padding: 40;">
                        <Label text="Alterar Senha"
                               style="-fx-font-size: 18px; -fx-text-fill: #424242; -fx-font-weight: 600; -fx-alignment: CENTER;"
                               maxWidth="Infinity"/>

                        <HBox alignment="CENTER">
                            <VBox spacing="20" style="-fx-min-width: 350; -fx-max-width: 350;">

                                <VBox spacing="8">
                                    <Label text="Senha de Login (para autenticação)"
                                           style="-fx-font-size: 14px; -fx-text-fill: #616161; -fx-font-weight: 600;"/>
                                    <VBox fx:id="currentPasswordFieldContainer" spacing="0"/>
                                    <Label fx:id="currentPasswordError" text="" styleClass="label-error"
                                           style="-fx-font-size: 13px; -fx-text-fill: #D32F2F; -fx-font-weight: 500;"
                                           visible="false" managed="false"/>
                                </VBox>

                                <VBox spacing="8">
                                    <Label text="Nova Senha do Cartão (4 dígitos)"
                                           style="-fx-font-size: 14px; -fx-text-fill: #616161; -fx-font-weight: 600;"/>
                                    <VBox fx:id="newPasswordFieldContainer" spacing="0"/>
                                    <Label fx:id="newPasswordError" text="" styleClass="label-error"
                                           style="-fx-font-size: 13px; -fx-text-fill: #D32F2F; -fx-font-weight: 500;"
                                           visible="false" managed="false"/>
                                </VBox>

                                <VBox spacing="8">
                                    <Label text="Confirmar Nova Senha (4 dígitos)"
                                           style="-fx-font-size: 14px; -fx-text-fill: #616161; -fx-font-weight: 600;"/>
                                    <VBox fx:id="confirmPasswordFieldContainer" spacing="0"/>
                                    <Label fx:id="confirmPasswordError" text="" styleClass="label-error"
                                           style="-fx-font-size: 13px; -fx-text-fill: #D32F2F; -fx-font-weight: 500;"
                                           visible="false" managed="false"/>
                                </VBox>

                            </VBox>
                        </HBox>

                        <HBox spacing="15" alignment="CENTER" style="-fx-padding: 10 0 0 0;">
                            <Button text="Cancelar" styleClass="button-secondary"
                                    onAction="#handleBack"
                                    style="-fx-pref-width: 200; -fx-pref-height: 50; -fx-font-size: 15px;"/>
                            <Button fx:id="confirmButton" text="Alterar Senha" styleClass="button-primary"
                                    onAction="#handleConfirm"
                                    style="-fx-pref-width: 200; -fx-pref-height: 50; -fx-font-size: 15px; -fx-background-color: #7B1FA2;"/>
                        </HBox>
                    </VBox>

                </VBox>
            </HBox>
        </ScrollPane>
    </center>

</BorderPane>
