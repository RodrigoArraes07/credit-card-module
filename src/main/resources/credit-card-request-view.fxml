<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.jala.university.presentation.controller.CreditCardRequestController"
      spacing="20"
      alignment="TOP_CENTER"
      style="-fx-background-color: #fafafa; -fx-padding: 30;">

    <Label text="Solicitar Cartão de Crédito"
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #333333;"/>

    <Label text="Preencha os dados abaixo para solicitar seu cartão"
           style="-fx-font-size: 14px; -fx-text-fill: #666666;"/>

    <VBox spacing="15" style="-fx-padding: 20 0 0 0;">
        <VBox spacing="5">
            <Label text="Nome Completo"
                   style="-fx-font-size: 12px; -fx-text-fill: #666666; -fx-font-weight: bold;"/>
            <TextField fx:id="nameField"
                      promptText="Digite seu nome completo"
                      style="-fx-pref-height: 40; -fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 10; -fx-font-size: 14px;"/>
        </VBox>

        <VBox spacing="5">
            <Label text="CPF"
                   style="-fx-font-size: 12px; -fx-text-fill: #666666; -fx-font-weight: bold;"/>
            <TextField fx:id="cpfField"
                      promptText="000.000.000-00"
                      style="-fx-pref-height: 40; -fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 10; -fx-font-size: 14px;"/>
        </VBox>

        <VBox spacing="5">
            <Label text="Email"
                   style="-fx-font-size: 12px; -fx-text-fill: #666666; -fx-font-weight: bold;"/>
            <TextField fx:id="emailField"
                      promptText="seu@email.com"
                      style="-fx-pref-height: 40; -fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 10; -fx-font-size: 14px;"/>
        </VBox>

        <VBox spacing="5">
            <Label text="Renda Mensal (R$)"
                   style="-fx-font-size: 12px; -fx-text-fill: #666666; -fx-font-weight: bold;"/>
            <TextField fx:id="incomeField"
                      promptText="0.00"
                      style="-fx-pref-height: 40; -fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 10; -fx-font-size: 14px;"/>
        </VBox>

        <HBox spacing="10" alignment="CENTER">
            <Button fx:id="calculateButton"
                   text="Calcular Limite"
                   onAction="#handleCalculateLimit"
                   prefWidth="200"
                   style="-fx-background-color: white; -fx-text-fill: #2196F3; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 5; -fx-border-color: #2196F3; -fx-border-radius: 5; -fx-border-width: 2; -fx-pref-height: 45; -fx-cursor: hand;"/>
        </HBox>

        <VBox fx:id="limitCard"
             alignment="CENTER"
             spacing="10"
             visible="false"
             managed="false"
             style="-fx-background-color: #f5f5f5; -fx-background-radius: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 10; -fx-border-width: 1; -fx-padding: 20;">
            <Label text="Limite Pré-Aprovado"
                   style="-fx-font-size: 12px; -fx-text-fill: #666666; -fx-font-weight: normal;"/>
            <Label fx:id="limitValue"
                   text="R$ 0,00"
                   style="-fx-font-size: 24px; -fx-text-fill: #2196F3; -fx-font-weight: bold;"/>
        </VBox>

        <VBox spacing="5" fx:id="passwordBox"
              visible="false"
              managed="false">
            <Label text="Crie uma senha de 4 dígitos"
                   style="-fx-font-size: 12px; -fx-text-fill: #666666; -fx-font-weight: bold;"/>
            <PasswordField fx:id="passwordField"
                          promptText="****"
                          style="-fx-pref-height: 40; -fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 10; -fx-font-size: 14px;"/>
        </VBox>

        <HBox spacing="10" alignment="CENTER" style="-fx-padding: 10 0 0 0;">
            <Button fx:id="submitButton"
                   text="Solicitar Cartão"
                   onAction="#handleSubmit"
                   prefWidth="200"
                   visible="false"
                   managed="false"
                   style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 5; -fx-pref-height: 45; -fx-cursor: hand;"/>
        </HBox>

        <Label fx:id="messageLabel"
               text=""
               style="-fx-font-size: 14px; -fx-font-weight: bold;"
               alignment="CENTER"
               visible="false"
               managed="false"
               wrapText="true"/>
    </VBox>
</VBox>
