<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.jala.university.presentation.controller.CreditCardRequestController"
           stylesheets="@styles/application.css"
           style="-fx-background: #F5F5F5; -fx-background-color: #F5F5F5;">

    <ScrollPane fitToWidth="true"
                style="-fx-background: #F5F5F5; -fx-background-color: #F5F5F5;">

        <VBox spacing="35" alignment="TOP_CENTER" style="-fx-background-color: #F5F5F5; -fx-padding: 40 50;">

            <HBox alignment="CENTER_LEFT" spacing="12">
                <Button styleClass="button-secondary"
                        onAction="#handleBack"
                        style="-fx-pref-width: 120; -fx-pref-height: 44;">
                    <graphic>
                        <HBox spacing="8" alignment="CENTER">
                            <FontAwesomeIconView glyphName="ARROW_LEFT" size="14" fill="#1565C0"/>
                            <Label text="Voltar"
                                   style="-fx-text-fill: #1565C0; -fx-font-weight: 600; -fx-font-size: 14px;"/>
                        </HBox>
                    </graphic>
                </Button>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>

            <VBox spacing="12" alignment="CENTER">
                <HBox spacing="12" alignment="CENTER">
                    <FontAwesomeIconView glyphName="FILE_TEXT_ALT" size="32" fill="#1565C0"/>
                    <Label text="Solicitação de Cartão"
                           style="-fx-font-size: 28px; -fx-font-weight: 700; -fx-text-fill: #212121; -fx-letter-spacing: 0.5;"/>
                </HBox>
                <Label text="Preencha seus dados para solicitar seu cartão de crédito"
                       style="-fx-font-size: 14px; -fx-text-fill: #757575; -fx-font-weight: 500;"/>
            </VBox>

            <VBox spacing="25" styleClass="card" style="-fx-padding: 35; -fx-max-width: 650;">

                <VBox spacing="12">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <FontAwesomeIconView glyphName="USER" size="16" fill="#616161"/>
                        <Label text="Nome Completo"
                               style="-fx-font-size: 13px; -fx-text-fill: #424242; -fx-font-weight: 600;"/>
                    </HBox>
                    <TextField fx:id="nameField"
                               promptText="Digite seu nome completo"
                               styleClass="text-field"
                               style="-fx-pref-height: 50;"/>
                </VBox>

                <HBox spacing="20">
                    <VBox spacing="12" HBox.hgrow="ALWAYS">
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <FontAwesomeIconView glyphName="ID_CARD" size="16" fill="#616161"/>
                            <Label text="CPF"
                                   style="-fx-font-size: 13px; -fx-text-fill: #424242; -fx-font-weight: 600;"/>
                        </HBox>
                        <TextField fx:id="cpfField"
                                   promptText="000.000.000-00"
                                   styleClass="text-field"
                                   style="-fx-pref-height: 50;"/>
                    </VBox>

                    <VBox spacing="12" HBox.hgrow="ALWAYS">
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <FontAwesomeIconView glyphName="ENVELOPE" size="16" fill="#616161"/>
                            <Label text="Email"
                                   style="-fx-font-size: 13px; -fx-text-fill: #424242; -fx-font-weight: 600;"/>
                        </HBox>
                        <TextField fx:id="emailField"
                                   promptText="seu@email.com"
                                   styleClass="text-field"
                                   style="-fx-pref-height: 50;"/>
                    </VBox>
                </HBox>

                <VBox spacing="12">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <FontAwesomeIconView glyphName="MONEY" size="16" fill="#2E7D32"/>
                        <Label text="Renda Mensal"
                               style="-fx-font-size: 13px; -fx-text-fill: #424242; -fx-font-weight: 600;"/>
                    </HBox>
                    <TextField fx:id="incomeField"
                               promptText="R$ 0,00"
                               styleClass="text-field"
                               style="-fx-pref-height: 50;"/>
                </VBox>

                <HBox alignment="CENTER" style="-fx-padding: 8 0;">
                    <Button fx:id="calculateButton"
                            text="Calcular Limite Pré-Aprovado"
                            styleClass="button-secondary"
                            onAction="#handleCalculateLimit"
                            style="-fx-pref-width: 280; -fx-pref-height: 48; -fx-font-size: 14px;">
                        <graphic>
                            <HBox spacing="8" alignment="CENTER">
                                <FontAwesomeIconView glyphName="CALCULATOR" size="16" fill="#1565C0"/>
                                <Label text="Calcular Limite"
                                       style="-fx-text-fill: #1565C0; -fx-font-weight: 600;"/>
                            </HBox>
                        </graphic>
                    </Button>
                </HBox>

                <VBox fx:id="limitCard"
                      alignment="CENTER" spacing="15"
                      visible="false" managed="false"
                      style="-fx-background-color: #E8F5E9; -fx-background-radius: 12; -fx-border-color: #2E7D32; -fx-border-radius: 12; -fx-border-width: 2; -fx-padding: 25;">
                    <HBox spacing="10" alignment="CENTER">
                        <FontAwesomeIconView glyphName="CHECK_CIRCLE" size="24" fill="#2E7D32"/>
                        <Label text="Limite Pré-Aprovado"
                               style="-fx-font-size: 14px; -fx-text-fill: #2E7D32; -fx-font-weight: 600;"/>
                    </HBox>
                    <Label fx:id="limitValue"
                           text="R$ 0,00"
                           style="-fx-font-size: 32px; -fx-text-fill: #2E7D32; -fx-font-weight: 700;"/>
                </VBox>

                <VBox spacing="12" fx:id="passwordBox"
                      visible="false" managed="false">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <FontAwesomeIconView glyphName="LOCK" size="16" fill="#616161"/>
                        <Label text="Senha de Login"
                               style="-fx-font-size: 13px; -fx-text-fill: #424242; -fx-font-weight: 600;"/>
                    </HBox>
                    <PasswordField fx:id="userPasswordField"
                                   promptText="Mínimo 6 caracteres"
                                   styleClass="text-field"
                                   style="-fx-pref-height: 50;"/>
                    <Label text="Esta senha será usada para acessar sua conta"
                           style="-fx-font-size: 12px; -fx-text-fill: #757575;"/>
                </VBox>

                <VBox spacing="12" fx:id="cardPasswordBox"
                      visible="false" managed="false">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <FontAwesomeIconView glyphName="KEY" size="16" fill="#616161"/>
                        <Label text="PIN do Cartão"
                               style="-fx-font-size: 13px; -fx-text-fill: #424242; -fx-font-weight: 600;"/>
                    </HBox>
                    <PasswordField fx:id="cardPasswordField"
                                   promptText="4 dígitos"
                                   styleClass="text-field"
                                   style="-fx-pref-height: 50;"/>
                    <Label text="PIN de 4 dígitos para utilizar o cartão"
                           style="-fx-font-size: 12px; -fx-text-fill: #757575;"/>
                </VBox>

                <HBox alignment="CENTER" style="-fx-padding: 15 0 0 0;">
                    <Button fx:id="submitButton"
                            text="Solicitar Cartão"
                            styleClass="button-primary"
                            onAction="#handleSubmit"
                            visible="false" managed="false"
                            style="-fx-pref-width: 280; -fx-pref-height: 52; -fx-font-size: 16px;">
                        <graphic>
                            <HBox spacing="10" alignment="CENTER">
                                <FontAwesomeIconView glyphName="CHECK" size="18" fill="white"/>
                                <Label text="Solicitar Cartão"
                                       style="-fx-text-fill: white; -fx-font-weight: 600; -fx-font-size: 16px;"/>
                            </HBox>
                        </graphic>
                    </Button>
                </HBox>

                <Label fx:id="messageLabel"
                       text=""
                       alignment="CENTER"
                       wrapText="true"
                       visible="false" managed="false"
                       style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-padding: 12; -fx-background-radius: 8;"/>
            </VBox>

        </VBox>
    </ScrollPane>
</StackPane>