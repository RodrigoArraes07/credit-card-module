<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.jala.university.presentation.controller.HomeController"
            stylesheets="@styles/application.css"
            style="-fx-background-color: #F5F5F5;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="15"
              style="-fx-background-color: white; -fx-padding: 18 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 6, 0, 0, 2);">

            <HBox alignment="CENTER_LEFT" spacing="12">
                <Circle radius="20" style="-fx-fill: #1565C0;"/>
                <Label text="JALA Bank" styleClass="text-title"
                       style="-fx-font-size: 18px; -fx-font-weight: 700;"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="userNameLabel" text="Olá, Maria"
                   style="-fx-font-size: 15px; -fx-text-fill: #424242; -fx-font-weight: 600;"/>

            <HBox spacing="10">
                <Button styleClass="icon-button">
                    <graphic>
                        <FontAwesomeIconView glyphName="USER" size="16" fill="#616161"/>
                    </graphic>
                </Button>

                <Button styleClass="icon-button">
                    <graphic>
                        <FontAwesomeIconView glyphName="BELL" size="16" fill="#616161"/>
                    </graphic>
                </Button>

                <Button styleClass="icon-button" onAction="#handleLogout">
                    <graphic>
                        <FontAwesomeIconView glyphName="SIGN_OUT" size="16" fill="#616161"/>
                    </graphic>
                </Button>
            </HBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox spacing="30" style="-fx-padding: 30;">

                <VBox fx:id="cardContainer" spacing="20">
                    <StackPane>
                        <VBox fx:id="addCardDisplay" spacing="20" alignment="CENTER"
                              styleClass="card"
                              style="-fx-pref-height: 220; -fx-max-width: 700; -fx-background-color: white; -fx-border-color: #E0E0E0; -fx-border-width: 2; -fx-border-style: dashed; -fx-border-radius: 16; -fx-background-radius: 16; -fx-cursor: hand;"
                              visible="false"
                              onMouseClicked="#handleRequestCard">
                            <StackPane>
                                <Circle radius="40" style="-fx-fill: #E3F2FD;"/>
                                <FontAwesomeIconView glyphName="PLUS" size="32" fill="#1565C0"/>
                            </StackPane>
                            <Label text="Adicionar novo cartão"
                                   style="-fx-font-size: 16px; -fx-text-fill: #1565C0; -fx-font-weight: 600;"/>
                            <Label text="Solicite um novo cartão de crédito"
                                   style="-fx-font-size: 13px; -fx-text-fill: #757575;"/>
                        </VBox>

                        <VBox fx:id="currentCardDisplay" spacing="20" alignment="CENTER"
                              styleClass="credit-card"
                              style="-fx-pref-height: 220; -fx-max-width: 700;">

                            <HBox alignment="CENTER_LEFT">
                                <Label text="JALA Bank"
                                       style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: 700; -fx-letter-spacing: 1;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <HBox fx:id="cardStatusBadgeContainer" alignment="CENTER_RIGHT" spacing="8"/>
                                <FontAwesomeIconView glyphName="CREDIT_CARD" size="32" fill="white" opacity="0.9"/>
                            </HBox>

                            <Region prefHeight="15"/>

                            <HBox alignment="CENTER_LEFT" spacing="30">
                                <FontAwesomeIconView glyphName="MOBILE" size="42" fill="white" opacity="0.8"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <FontAwesomeIconView glyphName="WIFI" size="32" fill="white" opacity="0.8"/>
                            </HBox>

                            <VBox spacing="18">
                                <Label fx:id="maskedCardLabel" text="•••• •••• •••• 1234"
                                       style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: 600; -fx-letter-spacing: 3;"/>

                                <HBox alignment="CENTER_LEFT" spacing="50">
                                    <VBox spacing="4">
                                        <Label text="VALID THRU" styleClass="text-tiny"
                                               style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 10px;"/>
                                        <Label text="12/28"
                                               style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: 600;"/>
                                    </VBox>

                                    <VBox spacing="4">
                                        <Label text="CARD HOLDER" styleClass="text-tiny"
                                               style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 10px;"/>
                                        <Label fx:id="cardHolderLabel" text="MARIA S. SILVA"
                                               style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: 600;"/>
                                    </VBox>
                                </HBox>
                            </VBox>
                        </VBox>

                        <HBox alignment="CENTER_LEFT" StackPane.alignment="CENTER_LEFT">
                            <Button fx:id="prevCardButton" styleClass="carousel-button" onAction="#handlePreviousCard"
                                    style="-fx-translate-x: -24;">
                                <graphic>
                                    <FontAwesomeIconView glyphName="CHEVRON_LEFT" size="20" fill="#1565C0"/>
                                </graphic>
                            </Button>
                        </HBox>

                        <HBox alignment="CENTER_RIGHT" StackPane.alignment="CENTER_RIGHT">
                            <Button fx:id="nextCardButton" styleClass="carousel-button" onAction="#handleNextCard"
                                    style="-fx-translate-x: 24;">
                                <graphic>
                                    <FontAwesomeIconView glyphName="CHEVRON_RIGHT" size="20" fill="#1565C0"/>
                                </graphic>
                            </Button>
                        </HBox>
                    </StackPane>

                    <HBox fx:id="carouselIndicators" alignment="CENTER" spacing="10">
                        <Circle radius="5" style="-fx-fill: #1565C0;"/>
                        <Circle radius="5" style="-fx-fill: #E0E0E0;"/>
                        <Circle radius="5" style="-fx-fill: #E0E0E0;"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="card"
                          style="-fx-padding: 20 25;">
                        <Label text="Limite Disponível"
                               style="-fx-font-size: 15px; -fx-text-fill: #757575; -fx-font-weight: 500;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="availableLimitLabel" text="R$ 5.000,00" styleClass="label-value"
                               style="-fx-font-size: 24px;"/>
                    </HBox>

                    <GridPane hgap="18" vgap="18">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="25"/>
                            <ColumnConstraints percentWidth="25"/>
                            <ColumnConstraints percentWidth="25"/>
                            <ColumnConstraints percentWidth="25"/>
                        </columnConstraints>

                        <VBox alignment="CENTER" spacing="12" GridPane.columnIndex="0"
                              onMouseClicked="#handlePayInvoice" styleClass="card"
                              style="-fx-cursor: hand; -fx-padding: 20 15;">
                            <StackPane>
                                <Circle radius="28" style="-fx-fill: #E8F5E9;"/>
                                <FontAwesomeIconView glyphName="FILE_TEXT" size="24" fill="#2E7D32"/>
                            </StackPane>
                            <Label text="Pagar Fatura"
                                   wrapText="true" textAlignment="CENTER"
                                   style="-fx-font-size: 12px; -fx-text-fill: #424242; -fx-font-weight: 600;"/>
                        </VBox>

                        <VBox alignment="CENTER" spacing="12" GridPane.columnIndex="1"
                              onMouseClicked="#handleVirtualCard" styleClass="card"
                              style="-fx-cursor: hand; -fx-padding: 20 15;">
                            <StackPane>
                                <Circle radius="28" style="-fx-fill: #E3F2FD;"/>
                                <FontAwesomeIconView glyphName="CREDIT_CARD_ALT" size="24" fill="#1565C0"/>
                            </StackPane>
                            <Label text="Cartão Virtual"
                                   wrapText="true" textAlignment="CENTER"
                                   style="-fx-font-size: 12px; -fx-text-fill: #424242; -fx-font-weight: 600;"/>
                        </VBox>

                        <VBox alignment="CENTER" spacing="12" GridPane.columnIndex="2"
                              onMouseClicked="#handleBlockCard" styleClass="card"
                              style="-fx-cursor: hand; -fx-padding: 20 15;">
                            <StackPane>
                                <Circle radius="28" style="-fx-fill: #FFEBEE;"/>
                                <FontAwesomeIconView glyphName="LOCK" size="24" fill="#D32F2F"/>
                            </StackPane>
                            <Label text="Bloquear Cartão"
                                   wrapText="true" textAlignment="CENTER"
                                   style="-fx-font-size: 12px; -fx-text-fill: #424242; -fx-font-weight: 600;"/>
                        </VBox>

                        <VBox alignment="CENTER" spacing="12" GridPane.columnIndex="3"
                              onMouseClicked="#handleAdjustLimit" styleClass="card"
                              style="-fx-cursor: hand; -fx-padding: 20 15;">
                            <StackPane>
                                <Circle radius="28" style="-fx-fill: #FFF3E0;"/>
                                <FontAwesomeIconView glyphName="SLIDERS" size="24" fill="#F57C00"/>
                            </StackPane>
                            <Label text="Ajustar Limite"
                                   wrapText="true" textAlignment="CENTER"
                                   style="-fx-font-size: 12px; -fx-text-fill: #424242; -fx-font-weight: 600;"/>
                        </VBox>
                    </GridPane>
                </VBox>

                <VBox fx:id="emptyStateContainer" alignment="CENTER" spacing="25" visible="false" managed="false"
                      styleClass="empty-state">
                    <FontAwesomeIconView glyphName="CREDIT_CARD" size="64" fill="#BDBDBD"/>
                    <VBox alignment="CENTER" spacing="8">
                        <Label text="Ainda não há cartões cadastrados"
                               style="-fx-font-size: 18px; -fx-text-fill: #616161; -fx-font-weight: 600;"/>
                        <Label text="Solicite seu primeiro cartão de crédito"
                               style="-fx-font-size: 14px; -fx-text-fill: #9E9E9E;"/>
                    </VBox>
                    <Button text="Solicitar Cartão" styleClass="button-primary"
                            onAction="#handleRequestCard"
                            style="-fx-pref-width: 220; -fx-pref-height: 50; -fx-font-size: 15px;"/>
                </VBox>

                <VBox fx:id="transactionsContainer" spacing="18" styleClass="card"
                      visible="false" managed="false">

                    <Label text="Transações Recentes" styleClass="label-header"
                           style="-fx-font-size: 18px;"/>

                    <VBox fx:id="transactionsList" spacing="0"/>

                    <Button text="Ver extrato completo" styleClass="button-secondary"
                            onAction="#handleViewFullStatement"
                            maxWidth="Infinity"
                            style="-fx-pref-height: 48; -fx-font-size: 14px;">
                        <padding>
                            <Insets top="12" right="20" bottom="12" left="20"/>
                        </padding>
                    </Button>
                </VBox>

                <VBox fx:id="emptyTransactionsState" alignment="CENTER" spacing="20"
                      styleClass="card" style="-fx-padding: 50;">
                    <FontAwesomeIconView glyphName="LIST_ALT" size="48" fill="#BDBDBD"/>
                    <VBox alignment="CENTER" spacing="6">
                        <Label text="Nenhuma transação recente"
                               style="-fx-font-size: 16px; -fx-text-fill: #616161; -fx-font-weight: 600;"/>
                        <Label text="Suas compras aparecerão aqui"
                               style="-fx-font-size: 13px; -fx-text-fill: #9E9E9E;"/>
                    </VBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
